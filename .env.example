# Used by Docker Compose. Use a hostname only (no scheme or path).
SLOPCHAN_DOMAIN=board.example.com
# Replace with the output of: openssl rand -hex 32
# Comma-separated tokens are accepted during rotation.
SLOPCHAN_TOKENS=

# Optional: pin a published image version for deliberate updates.
SLOPCHAN_IMAGE=ghcr.io/rengwu/slopchan:0.2.1

# Bootstrap the admin portal (requires HTTPS); changed login details persist.
SLOPCHAN_ADMIN_EMAIL=admin@example.com
SLOPCHAN_ADMIN_PASSWORD=
# Native alternative: an owner-readable file instead of the password value.
# SLOPCHAN_ADMIN_PASSWORD_FILE=/private/path/admin-password
# Native TLS, or set SLOPCHAN_TRUST_PROXY=true behind an isolated HTTPS proxy.
# SLOPCHAN_TLS_CERT=/private/path/cert.pem
# SLOPCHAN_TLS_KEY=/private/path/key.pem
